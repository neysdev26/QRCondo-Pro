{
  "expo": {
    "name": "QRCondo Pro App",
    "slug": "qrcondo-pro-app",
    "version": "1.0.28",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "encomendas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neysdev.qrcondopro"
    },
    "android": {
      "package": "com.neysdev.qrcondo_pro",
      "versionCode": 3,
      "backgroundColor": "#2E7D32",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "Permitimos o acesso para localizar moradores pelo Bloco/Apto."
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "cfaceb45-5ba8-4a9c-9951-b0dcc129a92c"
      },
      "router": {}
    }
  }
}